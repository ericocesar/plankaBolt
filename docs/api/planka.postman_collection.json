    "_postman_id": "8c1a6c6d-0b12-4b2e-8e7b-29f2b9a72c8d",
    "description": "Configure {{baseUrl}} e {{apiKey}}. O header x-api-key deve ser preenchido com a API Key gerada no frontend (Configurações do usuário → API Key).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "in",
        "value": "header",
        "type": "string"
      },
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
