  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Bootstrap",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bootstrap"
          }
        },
        {
          "name": "Get Current User (me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.item && body.item.id) {",
                  "  pm.collectionVariables.set('userId', body.item.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me"
          }
        }
      ]
    },
    {
      "name": "API Key",
      "item": [
        {
          "name": "Create/Regenerate API Key (returns full key once)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const apiKey = body?.included?.apiKey;",
                  "if (apiKey) {",
                  "  pm.collectionVariables.set('apiKey', apiKey);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}/api-key"
          }
        },
        {
          "name": "Delete API Key (PATCH user apiKey: null)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": null\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    },
